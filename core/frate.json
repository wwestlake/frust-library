    "clamp_i64", "clamp_f64",
    "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "sqrt", "cbrt",
    "pow", "exp", "log", "log2", "log10", "floor", "ceil", "round", "fmod", "hypot",
    "pi", "to_radians", "to_degrees",
    "len",
