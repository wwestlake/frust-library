// core/string - libc string.h functions, wrapped where Frust's type
// system can represent them correctly.
//
// Earlier revisions of this file assumed Frust had no way to represent
// a 32-bit `int` return, and skipped strcmp/strncmp/memcmp entirely for
// that reason. That assumption was wrong - Codegen.h's resolveType
// already maps `i32`/`u32` to a real LLVM i32, and compileBinary already
// auto-sign-extends a mismatched int width when comparing against an
// i64 literal. Verified directly: `strcmp("abc","abc")==0`,
// `strcmp("abc","abd")<0`, `strcmp("abd","abc")>0` all came back correct
// through an `extern fn ... -> i32` declaration. There was never a
// compiler gap here, just an untested assumption - see strcmp/strncmp
// below.
//
// strlen returns size_t, which is 64-bit on both target platforms -
// matches i64 exactly regardless of the above.
extern fn strlen(s: String) -> i64;

pub fn len(s: String) -> i64 = {
    strlen(s)
}

// -----------------------------------------------------------------------
// Parsing - atoll/atof are genuinely safe (both return a real 64-bit-
// matching value, long long and double respectively), and fill a real
// gap: without these, nothing in this pod could turn text into a number.
// Neither validates its input (matches libc: garbage input just yields
// 0), same "caller's problem" stance the rest of this pod already takes.
// -----------------------------------------------------------------------

extern fn atoll(s: String) -> i64;
extern fn atof(s: String) -> f64;

pub fn parse_i64(s: String) -> i64 = {
    atoll(s)
}

pub fn parse_f64(s: String) -> f64 = {
    atof(s)
}

// -----------------------------------------------------------------------
// Search/copy - all pointer-in/pointer-out, so all width-safe by the same
// reasoning as strlen above. strstr/strchr share mem.fr's documented
// null-testability gap (a "not found" result is a null pointer Frust
// can't yet test for) - only safe to use when the caller already knows
// the match exists. strcpy/strcat/etc. have zero bounds checking, same
// as in C - that's not a Frust limitation, it's what these functions are;
// prefer strncpy/strncat when the destination's capacity isn't already
// guaranteed large enough.
// -----------------------------------------------------------------------

extern fn strstr(haystack: String, needle: String) -> String;
extern fn strchr(s: String, c: i64) -> String;
extern fn strcpy(dest: String, src: String) -> String;
extern fn strncpy(dest: String, src: String, n: i64) -> String;
extern fn strcat(dest: String, src: String) -> String;
extern fn strncat(dest: String, src: String, n: i64) -> String;

pub fn find(haystack: String, needle: String) -> String = {
    strstr(haystack, needle)
}

pub fn find_char(s: String, c: i64) -> String = {
    strchr(s, c)
}

pub fn copy_into(dest: String, src: String) -> String = {
    strcpy(dest, src)
}

pub fn copy_n_into(dest: String, src: String, n: i64) -> String = {
    strncpy(dest, src, n)
}

pub fn append_into(dest: String, src: String) -> String = {
    strcat(dest, src)
}

pub fn append_n_into(dest: String, src: String, n: i64) -> String = {
    strncat(dest, src, n)
}

// -----------------------------------------------------------------------
// Comparison - real i32 returns, no width games needed (see header).
// Result follows libc convention: 0 if equal, <0 if a<b, >0 if a>b.
// -----------------------------------------------------------------------

extern fn strcmp(a: String, b: String) -> i32;
extern fn strncmp(a: String, b: String, n: i64) -> i32;

pub fn compare(a: String, b: String) -> i32 = {
    strcmp(a, b)
}

pub fn compare_n(a: String, b: String, n: i64) -> i32 = {
    strncmp(a, b, n)
}

pub fn equals(a: String, b: String) -> bool = {
    strcmp(a, b) == 0
}
