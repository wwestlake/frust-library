// core/procspawn - real OS process spawning, wrapping msvcrt's
// _spawnv/_putenv.
//
// Windows-only, same reasoning as thread.fr (Linux/Pi paused, no
// platform-conditional source mechanism yet).
//
// _spawnv, not raw CreateProcess: CreateProcess needs hand-populated
// STARTUPINFO/PROCESS_INFORMATION structs written at exact byte offsets
// - real, tedious, error-prone work for no benefit here. _spawnv takes
// a flat, null-terminated argv array - buildable with buffer.fr's
// set_ptr/null, the same way task.fr's packed buffers already are.
//
// A spawned process does NOT share this process's address space, so
// none of thread.fr/task.fr's pointer-passing tricks apply here - see
// process_task.fr for how results actually cross the boundary (an
// environment variable naming matching input/output files).

// _spawnv's real C return type is intptr_t - but under P_NOWAIT it's
// documented to be a Win32 process HANDLE (msvcrt's own _cwait expects
// exactly that back), and a HANDLE is pointer-shaped, not integer-
// shaped. Declared returning String (this pod's pointer stand-in), not
// i64, for exactly that reason: msvcrt's own _cwait was tried first and
// hung indefinitely even after the spawned child had already exited (a
// real, reproduced bug - see wait_process's comment for what actually
// works). Declaring the return as a pointer lets it flow straight into
// WaitForSingleObject with no int<->ptr cast Frust doesn't have -
// confirmed correct in isolation (WaitForSingleObject on this exact
// value returned WAIT_OBJECT_0 immediately, no hang).
extern fn _spawnv(mode: i64, cmdname: String, argv: String) -> String;
extern fn _putenv(envstring: String) -> i32;

pub fn wait_mode() -> i64 = {
    0 // P_WAIT, per <process.h> - spawn_wait*() blocks until the child exits
}

pub fn nowait_mode() -> i64 = {
    1 // P_NOWAIT - spawn_async*() returns immediately with a process
      // handle; call wait_process() on it later when you actually need
      // the result, not before.
}

// Blocks until the process behind proc_handle (from a spawn_async*
// function) exits, then releases the handle - reuses thread.fr's own
// WaitForSingleObject/CloseHandle (already declared there, compiled
// before this file - see lib.fr's ordering) rather than msvcrt's
// _cwait, which hung indefinitely in testing even on an already-exited
// child. Same proven mechanism thread.fr's join() already uses for OS
// threads; a spawned process's handle works identically here.
pub fn wait_process(proc_handle: String) = {
    WaitForSingleObject(proc_handle, wait_forever());
    CloseHandle(proc_handle)
}

// _spawnv does NOT quote argv elements when it reconstructs the single
// command-line string CreateProcess actually wants - verified directly:
// an unquoted path containing a space split into multiple argv entries
// in the child, which frust_compiler's own "one or more input files"
// parsing then tried to open as separate (nonexistent) source files.
// Every argv element built below is wrapped in literal quotes to avoid
// that - harmless for a path with no spaces, required for one that has
// them.
pub fn quote_arg(s: String) -> String = {
    concat(concat("\"", s), "\"")
}

// A 2-element argv (program name, NULL terminator) - the minimal valid
// argv for a program that takes its real input through the environment
// and files instead (see process_task.fr's convention).
pub fn argv1(arg0: String) -> String = {
    let argv: String = alloc(16);
    set_ptr(argv, 0, quote_arg(arg0));
    set_ptr(argv, 1, null);
    argv
}

// A 3-element argv (program name, one real argument, NULL terminator) -
// e.g. [frust_compiler.exe, worker.frust, NULL], matching how
// frust_compiler's own argv parsing already expects one-or-more input
// file paths after argv[0].
pub fn argv2(arg0: String, arg1: String) -> String = {
    let argv: String = alloc(24);
    set_ptr(argv, 0, quote_arg(arg0));
    set_ptr(argv, 1, quote_arg(arg1));
    set_ptr(argv, 2, null);
    argv
}

// Spawns cmdname with a 2-element argv [cmdname, arg1], blocks until it
// exits. _spawnv's own return under P_WAIT is a real exit code (an
// integer, not a handle) - but it's declared returning String above
// (needed for the P_NOWAIT/handle case spawn_async2 uses, and Frust
// resolves one `extern fn` name to one signature everywhere it's
// called). No caller of spawn_wait2 currently reads its result, so
// this stays void rather than forcing a meaningless pointer-typed
// "exit code" on callers - if you need the real exit code, that's a
// real, separate addition (a second export using a different C helper,
// not a signature this function can safely claim today).
pub fn spawn_wait2(cmdname: String, arg1: String) = {
    let argv: String = argv2(cmdname, arg1);
    _spawnv(wait_mode(), cmdname, argv);
}

// Same as spawn_wait2, but returns immediately with a process handle -
// pass it to wait_process() later when you actually need the result.
pub fn spawn_async2(cmdname: String, arg1: String) -> String = {
    let argv: String = argv2(cmdname, arg1);
    _spawnv(nowait_mode(), cmdname, argv)
}

// Sets an environment variable the CHILD process will inherit - call
// before spawn_wait, not after (env changes only propagate forward to
// processes spawned after the change).
pub fn set_env(name: String, value: String) = {
    let env_entry: String = concat(concat(name, "="), value);
    _putenv(env_entry)
}

// Spawns cmdname with a single-element argv, blocks until it exits.
// Same void-return reasoning as spawn_wait2 above.
pub fn spawn_wait(cmdname: String) = {
    let argv: String = argv1(cmdname);
    _spawnv(wait_mode(), cmdname, argv);
}
