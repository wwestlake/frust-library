// core/option - Option<T>: "a value, or nothing" (LANGUAGE_GAPS.md #5).
// A real discriminated union (LANGUAGE_GAPS.md's algebraic-data-types
// work), not the flag-struct hack this used to be - `match` enforces
// that both cases are handled, no `has_value` field to forget to check
// first.
//
// Some/None construction and Codegen.h's synthesized `Option::Some`/
// `Option::None` constructor functions come from this ONE enum
// declaration - no hand-written constructor sugar needed, unlike the
// old struct-based version:
//
//   let o: Option<i64> = Option::Some::<i64>(42);
//   let n: Option<i64> = Option::None::<i64>();
//   match (o) {
//       Option::Some(v) => v,
//       Option::None => 0,
//   }

enum Option<T> {
    Some(T),
    None
}
