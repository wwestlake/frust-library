// core - foundational Frust pod: not "add-ons," the basics every other
// pod in this library builds on.
//
// Every file compiled into this pod is named explicitly below, in the
// order it's compiled - frate reads these lines to build its file list,
// not a directory scan. A .fr file sitting in src/ that isn't `use
// self::`d here simply isn't part of the build; that's deliberate, not
// a bug (see FrustCompiler's CMakeLists/frate history for why).
use self::console_io; // string formatting/concatenation, println_*
use self::math;       // abs/min/max/clamp, trig, libm extras (pow/log/floor/...)
use self::string;     // libc string.h (only the 64-bit-safe parts - see file)
use self::mem;        // malloc/free/realloc/memcpy/memset/memmove
use self::file_io;    // fopen/fread/fwrite/fgets (no fclose yet - see file)
use self::time;       // clock() only (see file for why time() isn't here)
use self::random;     // dependency-free PRNG (Park-Miller LCG) - needs
                       // time's clock() for its default seed, so must
                       // compile after it
use self::process;    // exit/abort/getenv, panic/assert - panic() calls
                       // println_str, so must compile after console_io
use self::buffer;      // indexed i64/pointer read-write into a raw
                       // buffer - needs mem's alloc/dealloc naming
                       // convention but no compile-order dependency
use self::mutex;       // Win32 CRITICAL_SECTION wrapper - needs mem's
                       // alloc/dealloc, must compile after mem
use self::thread;       // Win32 CreateThread wrapper - needs mem's alloc
use self::task;         // the run/then task monad - needs thread AND
                       // buffer, must compile after both

// string.fr/mem.fr/file_io.fr all document the same real gap: Frust has
// no i32 type, so any libc function returning a plain C `int` can't be
// wrapped safely yet (strcmp, fclose, feof, ...). Not silently missing -
// each file lists exactly what's blocked and why.
