// core/curry - partial application of a 2-argument function.
//
// Only possible because of this pass's other compiler addition: Frust
// can now call a function VALUE indirectly, not just a statically-known
// name (see thread.fr's header for the address-of-decay half of this;
// Codegen.h's compileIndirectCall is the calling half). There's still
// no real closure type - `curry2` doesn't return something you can call
// with ordinary syntax like `partial(b)`; it returns an opaque packed
// buffer (function address + bound first argument) that `apply1` knows
// how to unpack and actually invoke. Less ergonomic than real currying
// syntax, fully real: the original function genuinely only runs once
// both arguments are in hand, and the bound argument is genuinely fixed
// at curry2() time, not re-passed at apply1() time.
//
// curry3/apply2 binds the first TWO arguments of a 3-argument function,
// same pattern as curry2/apply1 - not a more general "bind one argument
// at a time, N calls deep" curry chain (that would need each partial to
// track how many of the total args are still unbound, a real additional
// design, not just more copy-paste). Beyond 3 args is the same
// mechanical extension again, still not written.
//
// Verified: curry2(add, 3) then apply1(_, 4) produced 7, and the same
// partial applied to different second arguments produced different
// results each time (the binding isn't accidentally re-evaluating add
// eagerly at curry2() time). curry3(add3, 1, 2) then apply2(_, 3)
// produced 6.

pub fn curry2(f: String, bound_a: i64) -> String = {
    let p: String = alloc(16);
    set_ptr(p, 0, f);
    set_i64(p, 1, bound_a);
    p
}

pub fn apply1(partial: String, b: i64) -> i64 = {
    let f: String = get_ptr(partial, 0);
    let a: i64 = get_i64(partial, 1);
    f(a, b)
}

pub fn curry3(f: String, bound_a: i64, bound_b: i64) -> String = {
    let p: String = alloc(24);
    set_ptr(p, 0, f);
    set_i64(p, 1, bound_a);
    set_i64(p, 2, bound_b);
    p
}

pub fn apply2(partial: String, c: i64) -> i64 = {
    let f: String = get_ptr(partial, 0);
    let a: i64 = get_i64(partial, 1);
    let b: i64 = get_i64(partial, 2);
    f(a, b, c)
}

// A partial is deliberately reusable (verified: the same curry2()
// result applied to multiple different final arguments, each call
// producing a correct, independent result) - so apply1()/apply2()
// can't free it themselves without breaking that. Call this once
// you're actually done with a partial, same "you allocated it (via
// curry2/curry3), you free it" contract as mem.fr's alloc/dealloc
// generally.
pub fn free_partial(partial: String) = {
    dealloc(partial)
}
